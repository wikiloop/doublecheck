# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doublecheck?retryWrites=true&w=majority

# MediaWiki OAuth 2.0 consumer credentials (from meta.wikimedia.org)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Server port (default: 8000)
PORT=8000

# Node environment
NODE_ENV=development

# Session secret (random string, used for cookie signing)
SESSION_SECRET=

# Optional: Slack webhook for purge cron notifications
SLACK_WEBHOOK_URL=
