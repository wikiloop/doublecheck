{
  "name": "wikiloop-doublecheck",
  "version": "5.0.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "pnpm --filter @doublecheck/server dev",
    "build": "pnpm --filter @doublecheck/web build && pnpm --filter @doublecheck/server build",
    "start": "pnpm --filter @doublecheck/server start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r --parallel run test",
    "validate:phase0": "pnpm --filter @doublecheck/server validate:phase0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
