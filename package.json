{
  "name": "wikiloop-doublecheck",
  "version": "5.7.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "pnpm --filter @doublecheck/server dev",
    "build": "pnpm --filter @doublecheck/web build && pnpm --filter @doublecheck/userscript build && pnpm --filter @doublecheck/server build",
    "build:web": "pnpm --filter @doublecheck/web build",
    "build:userscript": "pnpm --filter @doublecheck/userscript build",
    "build:server": "pnpm --filter @doublecheck/server build",
    "start": "pnpm --filter @doublecheck/server start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r --parallel run test",
    "validate:phase0": "pnpm --filter @doublecheck/server validate:phase0",
    "deploy": "bash scripts/deploy.sh",
    "deploy:vercel": "bash scripts/deploy.sh vercel",
    "deploy:toolforge": "bash scripts/deploy.sh toolforge"
  },
  "dependencies": {
    "@doublecheck/core": "workspace:*",
    "@hono/node-server": "^1.0.0",
    "hono": "^4.0.0",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "chrome-webstore-upload-cli": "^3.5.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "google-auth-library": "^10.6.2",
    "playwright": "^1.58.2",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
