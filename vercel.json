{
  "buildCommand": "pnpm --filter @doublecheck/web build",
  "outputDirectory": "dist/web",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[[...route]]" },
    { "source": "/auth/(.*)", "destination": "/api/[[...route]]" },
    { "source": "/((?!api/|auth/).*)", "destination": "/index.html" }
  ]
}
