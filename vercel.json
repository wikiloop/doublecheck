{
  "buildCommand": "pnpm --filter @doublecheck/web build",
  "outputDirectory": "dist/web",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://wikiloop-doublecheck.toolforge.org/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://wikiloop-doublecheck.toolforge.org/auth/:path*" },
    { "source": "/((?!api/|auth/).*)", "destination": "/index.html" }
  ]
}
