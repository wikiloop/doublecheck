{
  "name": "@doublecheck/server",
  "version": "5.7.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "node -e \"const v=require('./package.json').version;let h='';try{h=require('child_process').execSync('git rev-parse --short=6 HEAD',{encoding:'utf8'}).trim()}catch{};require('fs').writeFileSync('build-info.json',JSON.stringify({version:h?v+'+'+h:v}))\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --dir src/__tests__/integration",
    "validate:phase0": "tsx scripts/validate-phase0.ts",
    "purge": "tsx src/cron/cli.ts"
  },
  "dependencies": {
    "@doublecheck/core": "workspace:*",
    "@hono/node-server": "^1.0.0",
    "hono": "^4.0.0",
    "mongoose": "^8.0.0",
    "node-cron": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
